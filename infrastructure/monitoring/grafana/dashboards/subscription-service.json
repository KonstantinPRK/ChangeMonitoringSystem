{
  "uid": "subscription-service",
  "title": "SubscriptionService — HTTP, JVM and delivery",
  "description": "Application health and durable subscription processing. Select an application and a Prometheus datasource.",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["ChangeMonitoringSystem", "subscription-service"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(subscription_requests_accepted_total, application)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"$application\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}}"}]
    },
    {
      "id": 2,
      "title": "HTTP 5xx errors / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "server errors"}]
    },
    {
      "id": 3,
      "title": "HTTP duration — p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\"}[$__rate_interval])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\"}[$__rate_interval])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"$application\"}[$__rate_interval])))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 4,
      "title": "JVM used memory by area and pool",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (area, id) (jvm_memory_used_bytes{application=\"$application\"})", "legendFormat": "{{area}} / {{id}}"}]
    },
    {
      "id": 5,
      "title": "Accepted subscriptions and tracker events / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(subscription_requests_accepted_total{application=\"$application\"}[$__rate_interval]))", "legendFormat": "subscriptions"},
        {"refId": "B", "expr": "sum(rate(subscription_updates_accepted_total{application=\"$application\"}[$__rate_interval]))", "legendFormat": "tracker events"}
      ]
    },
    {
      "id": 6,
      "title": "Processed subscription commands / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (action, changed) (rate(subscription_requests_processed_total{application=\"$application\"}[$__rate_interval]))", "legendFormat": "{{action}}, changed={{changed}}"}]
    },
    {
      "id": 7,
      "title": "Successful deliveries / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (kind) (rate(subscription_deliveries_total{application=\"$application\"}[$__rate_interval]))", "legendFormat": "{{kind}}"}]
    },
    {
      "id": 8,
      "title": "Processing and delivery failures / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (kind) (rate(subscription_failures_total{application=\"$application\"}[$__rate_interval]))", "legendFormat": "{{kind}}"}]
    },
    {
      "id": 9,
      "title": "Delivery duration p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (kind, le) (rate(subscription_delivery_duration_seconds_bucket{application=\"$application\"}[$__rate_interval])))", "legendFormat": "{{kind}}"}]
    },
    {
      "id": 10,
      "title": "Invalid events sent to DLQ / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(subscription_deliveries_total{application=\"$application\",kind=\"dlq\"}[$__rate_interval]))", "legendFormat": "invalid events"}]
    },
    {
      "id": 11,
      "title": "Active tracked links by service",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "max by (type) (subscription_links_active{application=\"$application\"})", "legendFormat": "{{type}}"}]
    },
    {
      "id": 12,
      "title": "Redis cache hits, misses and errors / second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (result) (rate(subscription_cache_total{application=\"$application\"}[$__rate_interval]))", "legendFormat": "{{result}}"}]
    }
  ]
}
